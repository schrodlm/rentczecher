{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "rentczecher",
  "version": "0.1.0",
  "identifier": "io.github.schrodlm.rentczecher",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && uv run python ../scripts/freeze_sidecar.py"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "rentczecher",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "sidecar/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
