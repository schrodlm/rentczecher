{
	"name": "gui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=18.17.0",
		"npm": ">=9.5.0"
	},
	"scripts": {
		"dev": "npm run build:locales && vite dev",
		"build": "npm run build:locales && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run build:locales && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"build:locales": "tsx scripts/build-locales.ts",
		"check:locales": "tsx scripts/extract-locales.ts",
		"extract:locales": "tsx scripts/extract-locales.ts --write"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/gettext-parser": "^9.0.0",
		"gettext-parser": "^9.1.1",
		"openapi-typescript": "^7.13.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"vite": "^8.0.16"
	}
}
