{
	"name": "gui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=20.0.0",
		"npm": ">=9.5.0"
	},
	"scripts": {
		"dev": "npm run codegen && vite dev",
		"build": "npm run codegen && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run codegen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"codegen": "npm run build:locales && npm run generate:api-types",
		"build:locales": "tsx scripts/build-locales.ts",
		"check:locales": "tsx scripts/extract-locales.ts",
		"extract:locales": "tsx scripts/extract-locales.ts --write",
		"generate:api-types": "openapi-typescript ../docs/api/openapi.json -o src/lib/api/types.gen.ts",
		"test": "npm run codegen && vitest run",
		"tauri": "tauri"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tauri-apps/cli": "^2.12.0",
		"@testing-library/jest-dom": "^6.9.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/gettext-parser": "^9.0.0",
		"gettext-parser": "^9.1.1",
		"jsdom": "^26.1.0",
		"openapi-typescript": "^7.13.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"openapi-fetch": "^0.17.0"
	}
}
